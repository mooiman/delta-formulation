# Plot after 15 min, ie 0.25 * 3600

openfile '.\c01_dx100d0\output\adv_diff_eq_dx100_dt20_map.nc'
selectfield 'Constituent'
hselectiontype '(M,N) point/path'
editt '46'
editmn '2:1:102'
colour [ 0 1 0 ]
linewidth 1.
marker '.'
plotcoordinate 'x coordinate'
quickview

