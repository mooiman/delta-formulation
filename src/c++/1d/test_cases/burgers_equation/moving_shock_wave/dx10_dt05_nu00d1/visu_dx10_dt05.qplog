openfile '.\output\burgers_eq_dx10_dt5_map.nc'
selectfield 'Velocity'
hselectiontype '(M,N) point/path'
editt '25'
editmn '850:1:1000'
colour [ 0 0 0 ]
marker '.'
plotcoordinate 'x coordinate'
quickview

openfile '.\output_01\burgers_eq_dx10_dt5_map.nc'
selectfield 'Velocity'
hselectiontype '(M,N) point/path'
editt '25'
editmn '850:1:1000'
colour [ 1 0 0 ]
marker '.'
plotcoordinate 'x coordinate'
addtoplot

